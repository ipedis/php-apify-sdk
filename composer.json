{
    "name": "docaxess/php-apify-sdk",
    "description": "Unofficial SDK for Apify service",
    "version": "2.0.3",
    "type": "library",
    "require": {
        "saloonphp/saloon": "^4.0",
        "php": ">=8.3",
        "citco/carbon": "^3.0"
    },
    "require-dev": {
        "pestphp/pest": "^5.0",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.29",
        "rector/rector": "^2.0",
        "symfony/var-dumper": "^8.0"
    },
    "license": "CC-BY-1.0",
    "autoload": {
        "psr-4": {
            "DocAxess\\Apify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Yanis",
            "email": "yanis.ghidouche@gmail.com"
        }
    ],
    "scripts": {
        "pint": "vendor/bin/pint",
        "pint:check": "vendor/bin/pint --test",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
        "rector": "vendor/bin/rector process",
        "rector:check": "vendor/bin/rector process --dry-run",
        "test": "php -d memory_limit=-1 vendor/bin/pest --colors=auto --display-warnings tests",
        "test:coverage": "php -d memory_limit=-1 vendor/bin/pest --colors=auto --coverage tests",
        "qa": [
            "@pint:check",
            "@phpstan",
            "@rector:check",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
